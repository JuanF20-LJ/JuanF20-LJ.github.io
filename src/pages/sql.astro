---
import Header from '../components/Header.astro';
import Project from "../components/Project_sql.astro";
import Sidebar from "../components/Sidebar.astro";
const projects = [
  {
    title: "Álgebra Relacional",
    desc: [
      "Antes de entrar en el lenguaje SQL, se entendió lo que hay detras. Eso vendría siendo el álgebra relacional. Este fue un taller realizado junto a una compañera de universidad.",
    ],
    img: "Foto Algebra.png",
    tech: [{name: "PDF EVIDENCIAS", link: "https://unbosqueeduco-my.sharepoint.com/:b:/g/personal/jlozadaj_unbosque_edu_co/IQAlxgNRJtLMRqUzcj4Su8CiARPgALC0cPjXbyi4RKrtEL8?e=YOY9I0"}]
  },
  {
    title: "Álgebra Relacional - Calculadora",
    desc: [
      "Se usó una calculdora de álgebra relacional para probar ejercicios y sentencias.",
    ],
    img: "RELAX.png",
    tech: [{name: "RELAX", link: "https://dbis-uibk.github.io/relax/calc/local/ufes/local/()"}]
  }
];
---

<!DOCTYPE html>
<html
>
  <Header title="SQL | JFLJ" />
  <body>
    <div class="content">
        <Sidebar selectedItem="evidencias" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Volver</div></a
            >
          </div>
          <div class="content-container">
            <h1>SQL</h1>
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                        img={project.img}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
