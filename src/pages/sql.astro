---
import Header from '../components/Header.astro';
import Project from "../components/Project_modelado.astro";
import Sidebar from "../components/Sidebar.astro";
const projects = [
  {
    title: "Modelado Aerolinea",
    desc: [
      "Ejercicio donde se hace el modelo entidad relación de una aerolinea.",
    ],
    img: "M.E.R. Aerolinea.drawio.png",
    tech: [{name: "DRAW.IO", link: "https://drive.google.com/file/d/1eoV5UgZ4Ajvt-ryevxCCOeUA0_4tVmhr/view?usp=sharing"}]
  },
  {
    title: "Modelado Biblioteca",
    desc: [
      "Ejercicio donde se hace el modelo entidad relación de una biblioteca.",
    ],
    img: "M. E. R. Biblioteca.drawio.png",
    tech: [{name: "DRAW.IO", link: "https://drive.google.com/file/d/1iclrXz4O1XK9naBpuMN35gMu7ujxgU6W/view?usp=sharing"}]
  },
  {
    title: "Modelado Arreglo Automóvil",
    desc: [
      "Ejercicio donde se hace el modelo entidad relación extendido de un caso de un concesionario en donde se arreglan vehículos. En el documento se encuentran tanto el modelo entidad relación extendido como la reducción a tablas.",
    ],
    img: "MERE_ArregloAutomovil-MERE.drawio.png",
    tech: [{name: "DRAW.IO", link: "https://drive.google.com/file/d/1rIFucP0LPHLjZU89O7ZgSDlcNn3pV4KO/view?usp=sharing"}]
  },
  {
    title: "Modelado Nómina",
    desc: [
      "Ejercicio donde se hace el modelo entidad relación extendido de un caso relacionado con la distribución de un área de una empresa. En el documento se encuentran tanto el modelo entidad relación extendido como la reducción a tablas.",
    ],
    img: "MERE_Nómina-MERE_Nómina.drawio.png",
    tech: [{name: "DRAW.IO", link: "https://drive.google.com/file/d/1fMfVAxnWFt4V0M7Sv_mG8ZnqyVPPLv0h/view?usp=sharing"}]
  },
  {
    title: "Modelado Residuos Tóxicos",
    desc: [
      "Ejercicio donde se hace el modelo entidad relación extendido de un caso de unas empresas que manejan y transportan residuos tóxicos. En el documento se encuentran tanto el modelo entidad relación extendido como la reducción a tablas.",
    ],
    img: "MERE_ResiduosTóxicos-MERE_ResiduosTóxicos.drawio.png",
    tech: [{name: "DRAW.IO", link: "https://drive.google.com/file/d/1WDWUrF5PynUug3FDFdLOKOtEDjycXop4/view?usp=sharing"}]
  },
  {
    title: "Modelado Comidas Rápidas",
    desc: [
      "Ejercicio donde se hace el modelo entidad relación extendido de un caso de una tienda de comidas rápidas. En el documento se encuentran tanto el modelo entidad relación extendido como la reducción a tablas.",
    ],
    img: "MERE_ComidasRápidas-MERE_ComidasRápidas.drawio.png",
    tech: [{name: "DRAW.IO", link: "https://drive.google.com/file/d/1GBd79HgpG6n_BpRsMu-FmX8Y3_E_FNvD/view?usp=sharing"}]
  }];
---

<!DOCTYPE html>
<html
>
  <Header title="SQL | JFLJ" />
  <body>
    <div class="content">
        <Sidebar selectedItem="evidencias-sql" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Volver</div></a
            >
          </div>
          <div class="content-container">
            <h1>SQL</h1>
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                        img={project.img}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
