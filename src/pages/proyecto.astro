---
import Header from '../components/Header.astro';
import Project from "../components/Project_proyecto.astro";
import Sidebar from "../components/Sidebar.astro";
const projects = [];
---

<!DOCTYPE html>
<html
>
  <Header title="PROYECTO | JFLJ" />
  <body>
    <div class="content">
        <Sidebar selectedItem="evidencias" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Volver</div></a
            >
          </div>
          <div class="content-container">
            <h1>Proyecto</h1>
            <p>En este apartado se encontrarán las evidencias relacionadas al proyecto final de la materia Base de Datos 2</p>
            <section class="items-container">
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                      title={project.title}
                      projectDesc={project.projectDesc}
                      items={project.items}
                      tech={project.tech}
                      img={project.img}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
