---
const { titulo, descripcion, aprendizaje, codigo } = Astro.props;
---

<div class="single-item">
  <h3>{titulo}</h3>

  {descripcion && (
    <div>
      <div class="mini-label-white gray-color">Descripción</div>
      <p class="seccion-texto">{descripcion}</p>
    </div>
  )}

  {aprendizaje && aprendizaje.length > 0 && (
    <div>
      <div class="mini-label-white gray-color">Lo que se aprendió</div>
      <ul class="lista-aprendizaje">
        {aprendizaje.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}

  <div class="mini-label-white">Código PL/SQL</div>
  <pre class="bloque-codigo"><code>{codigo}</code></pre>
</div>

<style>
  .seccion-texto {
    margin-top: 4px;
    margin-bottom: 0;
    white-space: pre-line;
  }

  .lista-aprendizaje {
    margin: 4px 0 0 0;
    padding-left: 22px;
    list-style-type: disc;
  }

  .lista-aprendizaje li {
    margin-bottom: 4px;
    list-style-type: disc;
  }

  .bloque-codigo {
    margin: 8px 0 0 0;
    padding: 16px 20px;
    background-color: #1f1f1f;
    border: 1px solid #353535;
    border-radius: 8px;
    color: #e6e6e6;
    font-family: IBM Plex Mono, monospace;
    font-size: 13px;
    line-height: 20px;
    white-space: pre;
    overflow: auto;
    max-height: 480px;
    tab-size: 2;
  }

  .bloque-codigo code {
    font-family: inherit;
  }
</style>
