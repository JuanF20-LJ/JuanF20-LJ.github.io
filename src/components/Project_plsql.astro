---
const { titulo, descripcion, aprendizaje, codigo, link, textoLink } = Astro.props;
---

<div class="single-item">
  <h3>{titulo}</h3>

  {descripcion && (
    <div>
      <div class="mini-label-white gray-color">Descripción</div>
      <p class="seccion-texto">{descripcion}</p>
    </div>
  )}

  {aprendizaje && (
    <div>
      <div class="mini-label-white gray-color">Lo que se aprendió</div>
      <p class="seccion-texto">{aprendizaje}</p>
    </div>
  )}

  <div class="mini-label-white">Código PL/SQL</div>
  <pre class="bloque-codigo"><code>{codigo}</code></pre>

  {link && (
    <div class="chips-container">
      <a href={link} target="_blank" class="single-chip">
        {textoLink ? textoLink : "Ver más"}
      </a>
    </div>
  )}
</div>

<style>
  .seccion-texto {
    margin-top: 4px;
    margin-bottom: 0;
    white-space: pre-line;
  }

  .bloque-codigo {
    margin: 8px 0 0 0;
    padding: 16px 20px;
    background-color: #1f1f1f;
    border: 1px solid #353535;
    border-radius: 8px;
    color: #e6e6e6;
    font-family: IBM Plex Mono, monospace;
    font-size: 13px;
    line-height: 20px;
    white-space: pre;
    overflow: auto;
    max-height: 480px;
    tab-size: 2;
  }

  .bloque-codigo code {
    font-family: inherit;
  }
</style>