---
const { selectedItem } = Astro.props;
---

<style>
  .dropdown-container {
    width: 100%;
  }

  .dropdown-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dropdown-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .dropdown-arrow {
    font-size: 12px;
    margin-left: 10px;
  }

  .dropdown-menu {
    display: none;
    flex-direction: column;
    margin-left: 35px;
    margin-top: 5px;
    gap: 6px;
  }

  .dropdown-container:hover .dropdown-menu {
    display: flex;
  }

  .dropdown-item {
    color: #bdbdbd;
    text-decoration: none;
    font-size: 14px;
    transition: 0.2s;
  }

  .dropdown-item:hover {
    color: white;
  }
</style>

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">
    <a href="/" class="w-nav-brand" aria-label="home">
      <div class="niv-data">
        <img
          src="/assets/juan.jpeg"
          loading="eager"
          alt="Profile picture"
          class="niv-image"
        />
        <div>
          <div class="label-white">Juan Felipe</div>
          <div class="label-gray">Ingeniero de Sistemas</div>
        </div>
      </div>
    </a>

    <nav role="navigation" class="w-nav-menu">
      <a
        href="/"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'home' ? 'w--current' : ''
        }`}
      >
        <img
          src="/assets/home.svg"
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Principal</div>
      </a>
      <a
        href="/presentacion"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'presentacion' ? 'w--current' : ''
        }`}
        aria-current={
          selectedItem === 'presentacion' ? 'page' : undefined
        }
      >
        <img
          src="/assets/favorite.svg"
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Presentación</div>
      </a>
      <div class="dropdown-container">
        <div
          class={`nav-link-container dropdown-toggle ${
            selectedItem?.startsWith('evidencias')
              ? 'w--current'
              : ''
          }`}
        >
          <img
            src="/assets/dns.svg"
            loading="eager"
            alt=""
            class="nav-link-image"
          />

          <div class="dropdown-title">
            <span>Evidencias</span>
            <span class="dropdown-arrow">▼</span>
          </div>
        </div>

        <div class="dropdown-menu">
          <a
            href="/sql"
            class={`dropdown-item ${
              selectedItem === 'evidencias-sql'
                ? 'w--current'
                : ''
            }`}
          >
            SQL
          </a>

          <a
            href="/plsql"
            class={`dropdown-item ${
              selectedItem === 'evidencias-plsql'
                ? 'w--current'
                : ''
            }`}
          >
            PL/SQL Scripts
          </a>

          <a
            href="/nosql"
            class={`dropdown-item ${
              selectedItem === 'evidencias-nosql'
                ? 'w--current'
                : ''
            }`}
          >
            NoSQL
          </a>

          <a
            href="/proyecto"
            class={`dropdown-item ${
              selectedItem === 'evidencias-proyecto'
                ? 'w--current'
                : ''
            }`}
          >
            Proyecto
          </a>
        </div>
      </div>
    </nav>

    <div
      class="navbar-icon-button w-nav-button"
      style="-webkit-user-select: text;"
      aria-label="menu"
      role="button"
      tabindex="0"
    >
      <img
        src="/assets/menu.svg"
        loading="eager"
        alt=""
        class="navbar-icon"
      />
    </div>
  </div>

  <script>
    import { setupNav } from '../scripts/nav.js';
    
    let cleanup;
    document.addEventListener('astro:page-load', () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
    });

    document.addEventListener('astro:before-swap', () => {
      if (cleanup) cleanup();
    });
  </script>
</aside>
