---
const {
  title,
  projectDesc,
  items,
  img,
  tech
} = Astro.props;
---

<div class="single-item custom-card">
  <h3 class="project-title">{title}</h3>

  <p class="project-description">
    {projectDesc}
  </p>

  {
    img && (
      <div class="image-container">
        <img
          src={"/assets/" + img}
          alt="Imagen del proyecto"
          class="project-image"
        />
      </div>
    )
  }

  <div class="items-section">
    <div class="section-title">
      Evidencias / Recursos
    </div>

    <div class="items-list">
      {
        items.map(item => (
          <div class="item-card">
            <div class="item-title">
              {item.title}
            </div>

            <p class="item-description">
              {item.description}
            </p>

            <a
              href={item.link}
              target="_blank"
              class="item-link"
            >
              Ver recurso
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <div class="tech-section">
    <div class="section-title">
      Tecnologías Usadas
    </div>

    <div class="chips-container">
      {
        tech.map(techItem => (
          <a
            href={techItem.link}
            target="_blank"
            class="single-chip"
          >
            {techItem.name}
          </a>
        ))
      }
    </div>
  </div>
</div>