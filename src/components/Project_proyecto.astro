---
const {
  titulo,
  descripcion,
  imagen,
  video,
  enlaces,
  elementos
} = Astro.props;
---

<div class="single-item custom-card">

  <h3 class="project-title">{titulo}</h3>

  {descripcion && (
    <p class="project-description">{descripcion}</p>
  )}

  {imagen && (
    <div class="image-container">
      <img src={imagen} alt={titulo} class="project-logo" />
    </div>
  )}

  {(video || enlaces) && (
    <div class="section-title">Recursos</div>
  )}

  {video && (
    <div class="video-container">
      <iframe
        src={video}
        title={titulo}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  )}

  {enlaces && (
    <div class="links-list">
      {enlaces.map(enlace => (
        <a href={enlace.url} target="_blank" class="item-link">
          {enlace.nombre}
        </a>
      ))}
    </div>
  )}

  {elementos && (
    <div class="items-list">
      {elementos.map(elemento => (
        <div class="item-card">

          <div class="item-title">{elemento.titulo}</div>

          {elemento.descripcion && (
            <p class="item-description">{elemento.descripcion}</p>
          )}

          {elemento.imagen && (
            <a href={elemento.imagen} target="_blank">
              <img src={elemento.imagen} alt={elemento.titulo} class="item-image" />
            </a>
          )}

          {elemento.codigo && (
            <pre class="bloque-codigo"><code>{elemento.codigo}</code></pre>
          )}

          {(elemento.documento || elemento.archivo) && (
            <div class="links-list">
              {elemento.documento && (
                <a href={elemento.documento} target="_blank" class="item-link">
                  {elemento.textoDocumento ? elemento.textoDocumento : "Ver documento"}
                </a>
              )}
              {elemento.archivo && (
                <a href={elemento.archivo} download class="item-link">
                  {elemento.textoArchivo ? elemento.textoArchivo : "Descargar archivo"}
                </a>
              )}
            </div>
          )}

        </div>
      ))}
    </div>
  )}

</div>

<style>
  .custom-card {
    background-color: #1c1c1c;
    border: 1px solid #353535;
    border-radius: 16px;
    padding: 28px;
  }

  .project-title {
    margin-bottom: 18px;
  }

  .project-description {
    margin-bottom: 8px;
    white-space: pre-line;
  }

  .image-container {
    text-align: center;
    margin: 24px 0;
  }

  .project-logo {
    width: 100%;
    max-width: 220px;
  }

  .section-title {
    color: #fff;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    margin-top: 24px;
    margin-bottom: 12px;
    font-family: IBM Plex Mono, sans-serif;
    font-size: 10px;
  }

  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #353535;
    margin-bottom: 16px;
  }

  .video-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .links-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  .items-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 8px;
  }

  .item-card {
    background-color: #232323;
    border: 1px solid #353535;
    border-radius: 12px;
    padding: 20px;
  }

  .item-title {
    color: white;
    font-size: 18px;
    margin-bottom: 10px;
  }

  .item-description {
    margin-bottom: 12px;
    white-space: pre-line;
  }

  .item-image {
    display: block;
    width: 100%;
    border-radius: 8px;
    border: 1px solid #353535;
    background-color: #ffffff;
  }

  .item-link {
    display: inline-block;
    color: white;
    background-color: #2b2b2b;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 10px 16px;
    text-decoration: none;
    transition: 0.2s;
  }

  .item-link:hover {
    background-color: #3a3a3a;
    transform: translateY(-2px);
  }

  .bloque-codigo {
    margin: 8px 0 0 0;
    padding: 16px 20px;
    background-color: #1f1f1f;
    border: 1px solid #353535;
    border-radius: 8px;
    color: #e6e6e6;
    font-family: IBM Plex Mono, monospace;
    font-size: 13px;
    line-height: 20px;
    white-space: pre;
    overflow: auto;
    max-height: 480px;
    tab-size: 2;
  }

  .bloque-codigo code {
    font-family: inherit;
  }
</style>
