---
const {
  title,
  projectDesc,
  items,
  img,
  tech
} = Astro.props;
---

<div class="single-item custom-card">

  <h3 class="project-title">{title}</h3>

  <p class="project-description">
    {projectDesc}
  </p>

  {
    img && (
      <div class="image-container">
        <img
          src={"/assets/" + img}
          alt="Imagen del proyecto"
          class="project-image"
        />
      </div>
    )
  }

  <div class="items-section">

    <div class="section-title">
      Evidencias / Recursos
    </div>

    <div class="items-list">
      {
        items.map(item => (
          <div class="item-card">

            <div class="item-title">
              {item.title}
            </div>

            <p class="item-description">
              {item.description}
            </p>

            <a
              href={item.link}
              target="_blank"
              class="item-link"
            >
              Ver recurso
            </a>

          </div>
        ))
      }
    </div>
  </div>

  <div class="tech-section">

    <div class="section-title">
      Tecnologías Usadas
    </div>

    <div class="chips-container">
      {
        tech.map(techItem => (
          <a
            href={techItem.link}
            target="_blank"
            class="single-chip tech-chip"
          >
            {techItem.name}
          </a>
        ))
      }
    </div>

  </div>

</div>

<style>
  .custom-card {
    background-color: #1c1c1c;
    border: 1px solid #353535;
    border-radius: 16px;
    padding: 28px;
  }

  .project-title {
    margin-bottom: 18px;
  }

  .project-description {
    margin-bottom: 24px;
  }

  .image-container {
    text-align: center;
    margin: 30px 0;
  }

  .project-image {
    width: 100%;
    max-width: 520px;
    border-radius: 12px;
    border: 1px solid #353535;
  }

  .section-title {
    color: #fff;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    margin-top: 24px;
    margin-bottom: 12px;
    font-family: IBM Plex Mono, sans-serif;
    font-size: 10px;
  }

  .items-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .item-card {
    background-color: #232323;
    border: 1px solid #353535;
    border-radius: 12px;
    padding: 20px;
  }

  .item-title {
    color: white;
    font-size: 18px;
    margin-bottom: 10px;
  }

  .item-description {
    margin-bottom: 16px;
  }

  .item-link {
    display: inline-block;
    color: white;
    background-color: #2b2b2b;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 10px 16px;
    text-decoration: none;
    transition: 0.2s;
  }

  .item-link:hover {
    background-color: #3a3a3a;
    transform: translateY(-2px);
  }

  .tech-chip {
    text-decoration: none;
    transition: 0.2s;
  }

  .tech-chip:hover {
    background-color: #4a4a4a;
    transform: translateY(-2px);
  }
</style>